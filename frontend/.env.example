VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_API_BASE_URL=https://YOUR_RENDER_BACKEND.onrender.com
# Public Google reCAPTCHA v3 site key. Configure the Supabase Auth hook before enabling signup.
# See docs/RECAPTCHA_SETUP.md. Never put the Google secret key in a VITE_ variable.
VITE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY
# Enable only after applying supabase/migrations/202609170001_live_support_sessions.sql.
VITE_SUPPORT_ENABLED=false
