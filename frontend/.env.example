VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_API_BASE_URL=https://YOUR_RENDER_BACKEND.onrender.com
# Public Google reCAPTCHA v3 site key. Configure the Supabase Auth hook before enabling signup.
# See README.md for hook setup. Keep the Google secret key on the backend.
VITE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY
# Enable only when live support tables, RPCs, and private Realtime policies are deployed.
VITE_SUPPORT_ENABLED=false
