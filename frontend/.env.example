# Required even for guest mode: use your own provisioned Supabase project.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public anon/publishable key only; never use a backend secret or service-role key.
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Local backend origin, without /api. Replace with your backend HTTPS origin for deployment.
VITE_API_BASE_URL=http://localhost:3000
# Public Google reCAPTCHA v3 site key. Configure the Supabase Auth hook before enabling signup.
# See README.md for hook setup. Keep the Google secret key on the backend.
VITE_RECAPTCHA_SITE_KEY=YOUR_RECAPTCHA_V3_SITE_KEY
# Enable only when live support tables, RPCs, and private Realtime policies are deployed.
VITE_SUPPORT_ENABLED=false
# Sentry React project DSN. Leave empty to disable error reporting locally.
VITE_SENTRY_DSN=
# Optional source-map uploads at build time. Set all three together in Netlify.
# SENTRY_AUTH_TOKEN is private: never prefix it with VITE_.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
