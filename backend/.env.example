PORT=3000
# Player-name login: use the project URL and a backend-only sb_secret_ API key.
# Set these in Vercel. Never add the secret key to a VITE_ variable.
# Enable Authentication > Rate Limits > IP Address Forwarding in Supabase.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_BACKEND_SUPABASE_SECRET_KEY
# Comma-separated exact browser origins. Do not use wildcard preview domains.
CORS_ORIGINS=https://pr-codesense.netlify.app
# Set to true only when debugging request volume; never logs submitted source code
LOG_ANALYSIS_REQUESTS=false
# Optional positive integers. Defaults: 60000 ms, 60 API requests, 20 analyses.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_MAX_ANALYZE_REQUESTS=20
# Registration: Supabase Before User Created HTTP hook and Google reCAPTCHA v3.
# Keep both secrets exclusively on the backend. Use exact hostnames, without ports.
AUTH_HOOK_SECRET=v1,whsec_YOUR_SUPABASE_AUTH_HOOK_SIGNING_SECRET
RECAPTCHA_SECRET_KEY=YOUR_GOOGLE_RECAPTCHA_V3_SECRET_KEY
RECAPTCHA_ALLOWED_HOSTNAMES=localhost,pr-codesense.netlify.app
RECAPTCHA_MIN_SCORE=0.5
# Sentry Express project DSN. Leave empty to disable error reporting locally.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Optional deployment commit SHA or release identifier.
SENTRY_RELEASE=
